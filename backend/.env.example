# Port API
PORT=5175

# Asal permintaan yang diizinkan (dipisah koma). Kosongkan untuk mengizinkan semua.
FRONTEND_URL=http://localhost:5173

# Rahasia penandatanganan JWT — WAJIB diganti di lingkungan produksi.
JWT_SECRET=ganti-dengan-rahasia-acak-yang-panjang
JWT_EXPIRE=7d

# Akun demo yang di-seed saat API pertama kali berjalan.
SEED_USER_NAME=admin
SEED_USER_PASSWORD=be_jogja

# Interval pembangkitan sampel telemetri (ms)
TICK_INTERVAL_MS=200
