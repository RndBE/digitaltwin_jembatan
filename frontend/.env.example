# Mode peraga adalah bawaan: seluruh angka dibangkitkan mesin simulasi di
# peramban dan data contoh, tanpa memerlukan server sama sekali.
#
# Setel ke true untuk menyambungkan antarmuka ke API Express.
VITE_API_ENABLED=false

# Alamat API bila dipasang pada asal yang berbeda.
# Kosongkan untuk memakai proxy peladen pengembangan (/api).
VITE_API_BASE=
